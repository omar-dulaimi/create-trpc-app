{
  "name": "trpc-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:server": "tsx watch src/server",
    "dev:client": "wait-port 2021 && tsx watch src/client",
    "dev": "run-p dev:* --print-label",
    "type-check": "tsc",
    "build": "esbuild src/server.ts src/client.ts --bundle --packages=external --platform=node --format=esm --outdir=dist --sourcemap",
    "test-dev": "start-server-and-test 'tsx src/server' 2021 'tsx src/client'",
    "test-start": "npm run build && start-server-and-test 'node dist/server.js' 2021 'node dist/client.js'"
  },
  "dependencies": {
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "start-server-and-test": "^3.0.11",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "wait-port": "^1.1.0"
  }
}
