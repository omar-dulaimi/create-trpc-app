{
  "name": "create-trpc-appx",
  "//": "Not the source of truth for releases: semantic-release derives the next version from git tags and writes it into package/package.json at publish time. Kept in step with the latest published version so a manual `npm run package:publish` cannot silently target an existing one.",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "keywords": [
    "trpc",
    "create-trpc-app"
  ],
  "description": "Create tRPC-powered apps with one command",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omar-dulaimi/create-trpc-app.git"
  },
  "author": {
    "name": "Omar Dulaimi",
    "url": "https://github.com/omar-dulaimi"
  },
  "license": "MIT",
  "bin": {
    "create-trpc-appx": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rimraf dist && tsup index.ts helpers/run.ts helpers/templates.ts helpers/copy-template.ts --format esm --dts && cp -r templates dist",
    "doctor": "node dist/index.js doctor",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node tests/run.test.mjs && node tests/pm.test.mjs && node tests/templates.test.mjs && node tests/publish-hygiene.test.mjs",
    "release": "semantic-release",
    "package:publish": "./package.sh && cd package && npm publish",
    "test:smoke": "node tests/smoke.mjs",
    "lint": "eslint . --ext .ts,.js --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "async-retry": "1.3.3",
    "chalk": "^4.1.2",
    "commander": "12.0.0",
    "cross-spawn": "^7.0.6",
    "got": "^14.2.1",
    "ora": "^8.2.0",
    "prompts": "2.4.2",
    "semver": "^7.6.3",
    "tar": "^7.5.22",
    "unzipper": "^0.12.5",
    "update-check": "1.5.4",
    "validate-npm-package-name": "5.0.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/async-retry": "1.4.8",
    "@types/cross-spawn": "^6.0.6",
    "@types/got": "^9.6.12",
    "@types/node": "^22.19.0",
    "@types/prompts": "2.4.9",
    "@types/semver": "^7.5.8",
    "@types/validate-npm-package-name": "4.0.2",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^9.33.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^15.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.8",
    "tsup": "^7.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
}
