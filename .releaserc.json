{
  "branches": ["master"],
  "//": "Set explicitly: @semantic-release/github parses npm's `git+https://` form into an empty $owner, and its fail step then dies on an invalid $owner variable, masking the real error.",
  "repositoryUrl": "https://github.com/omar-dulaimi/create-trpc-app.git",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "type": "feat", "release": "minor" },
          { "type": "fix", "release": "patch" },
          { "type": "perf", "release": "patch" },
          { "type": "revert", "release": "patch" },
          { "type": "refactor", "release": "patch" },
          { "type": "docs", "release": false },
          { "type": "style", "release": false },
          { "type": "chore", "release": false },
          { "type": "test", "release": false },
          { "type": "build", "release": false },
          { "type": "ci", "release": false },
          { "scope": "breaking", "release": "major" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "🚀 Features" },
            { "type": "fix", "section": "🐛 Bug Fixes" },
            { "type": "perf", "section": "⚡ Performance Improvements" },
            { "type": "revert", "section": "⏪ Reverts" },
            { "type": "refactor", "section": "♻️ Code Refactoring" },
            { "type": "docs", "section": "📚 Documentation", "hidden": false },
            { "type": "style", "section": "💄 Styles", "hidden": true },
            { "type": "chore", "section": "🔧 Miscellaneous Chores", "hidden": true },
            { "type": "test", "section": "✅ Tests", "hidden": true },
            { "type": "build", "section": "🏗️ Build System", "hidden": true },
            { "type": "ci", "section": "👷 CI/CD", "hidden": true }
          ]
        }
      }
    ],
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    [
      "@semantic-release/npm",
      {
        "//": "This repo publishes the curated directory that package.sh assembles, not the repo root. The release workflow must run package.sh BEFORE semantic-release: verifyConditions reads package/package.json at the very start of the run.",
        "pkgRoot": "package"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": "🎉 Released in [v${nextRelease.version}](https://www.npmjs.com/package/create-trpc-appx/v/${nextRelease.version}).",
        "//": "No failure issue: the workflow run already reports it, and the fail step's own GraphQL call was erroring and masking the real cause.",
        "failComment": false,
        "failTitle": false,
        "labels": ["released"]
      }
    ]
  ]
}
